# Copy to .env.local when a clean local profile is needed.
# ZASMAOLT_API_KEY must match OMNISENTINEL_SERVICE_API_KEY in api_zaSmaOlt.
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
API_PREFIX=api/v1
CORS_ORIGINS=http://localhost:3101
DATABASE_URL=postgresql://incident_user:local_dev_password@postgres:5432/omniSentinel_db?schema=public
RABBITMQ_ENABLED=true
RABBITMQ_URL=amqp://incident_user:local_dev_rabbit_password@rabbitmq:5672
RABBITMQ_EVENTS_EXCHANGE=network.events
RABBITMQ_HEALTH_QUEUE=api_incident_report.health
RABBITMQ_ALERT_QUEUE=api_incident_report.alerts
RABBITMQ_ALERT_RETRY_QUEUE=api_incident_report.alerts.retry
RABBITMQ_MAX_RETRIES=3
RABBITMQ_RETRY_DELAY_MS=5000
ZASMAOLT_API_URL=http://api_zasmaolt:3010
ZASMAOLT_API_KEY=local-omnisentinel-service-key-2026
ZASMAOLT_INGEST_API_KEY=local-direct-ingest-key-not-used
ZASMAOLT_ADAPTER_MODE=http
ZASMAOLT_API_KEY_HEADER=x-api-key
ZASMAOLT_TIMEOUT_MS=5000
ZASMAOLT_CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
ZASMAOLT_CIRCUIT_BREAKER_RESET_SECONDS=30
ZASMAOLT_EVENT_PULL_ENABLED=true
ZASMAOLT_EVENT_PULL_INTERVAL_MS=15000
ZASMAOLT_EVENT_PULL_BATCH_SIZE=100
REPORT_STORAGE_PATH=/app/storage/reports
JWT_SECRET=local-development-jwt-secret-change-before-production-2026
JWT_REFRESH_SECRET=local-development-refresh-secret-change-before-production-2026
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL_DAYS=7
ADMIN_EMAIL=admin@example.com
ADMIN_USERNAME=localadmin
ADMIN_PASSWORD=local-admin-password
SMTP_HOST=
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@omnisentinel.local
NOTIFICATION_EMAIL_RECIPIENTS=
NOTIFICATION_WEBHOOK_TIMEOUT_MS=5000
INCIDENT_CORRELATION_WINDOW_SECONDS=60
INCIDENT_STABILIZATION_MINUTES=5
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_LIMIT=100
SWAGGER_ENABLED=true
METRICS_ENABLED=false
METRICS_BEARER_TOKEN=
TRUST_PROXY=false

NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
CORS_ORIGINS=http://localhost:3000
DATABASE_URL=postgresql://incident_user:123456@postgres.db:5432/omniSentinel_db?schema=public
REDIS_URL=redis://localhost:6379
RABBITMQ_URL=amqp://incident_user:incident_password@localhost:5672
RABBITMQ_EVENTS_EXCHANGE=network.events
RABBITMQ_HEALTH_QUEUE=api_incident_report.health
ZASMAOLT_API_URL=http://host.docker.internal:3001
ZASMAOLT_API_KEY=replace-with-a-development-key
REPORT_STORAGE_PATH=./storage/reports
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret-at-least-32-characters
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
INCIDENT_CORRELATION_WINDOW_SECONDS=60
INCIDENT_STABILIZATION_MINUTES=5

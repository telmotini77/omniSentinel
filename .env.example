NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
CORS_ORIGINS=http://localhost:3000
DATABASE_URL=postgresql://incident_user:123456@localhost:5433/omniSentinel_db?schema=public
REDIS_URL=redis://localhost:6379
RABBITMQ_URL=amqp://incident_user:incident_password@localhost:5672
RABBITMQ_EVENTS_EXCHANGE=network.events
RABBITMQ_HEALTH_QUEUE=api_incident_report.health
# For host-local api_zaSmaOlt use http://localhost:3010. For the production
# source, use its HTTPS address once its TLS certificate is active.
ZASMAOLT_API_URL=http://localhost:3010
# This is OMNISENTINEL_SERVICE_API_KEY from api_zaSmaOlt, not a Smart OLT key.
ZASMAOLT_API_KEY=replace-with-api-zaSmaOlt-service-api-key
# This is the separate key api_zaSmaOlt uses only to publish events here.
ZASMAOLT_INGEST_API_KEY=replace-with-a-different-api-zaSmaOlt-ingest-key
ZASMAOLT_ADAPTER_MODE=http
ZASMAOLT_API_KEY_HEADER=x-api-key
ZASMAOLT_TIMEOUT_MS=5000
ZASMAOLT_CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
ZASMAOLT_CIRCUIT_BREAKER_RESET_SECONDS=30
# OmniSentinel pulls confirmed source events through /integration/v1/events.
# This removes the need to expose this local machine to the public internet.
ZASMAOLT_EVENT_PULL_ENABLED=true
ZASMAOLT_EVENT_PULL_INTERVAL_MS=15000
ZASMAOLT_EVENT_PULL_BATCH_SIZE=100
REPORT_STORAGE_PATH=./storage/reports
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret-at-least-32-characters
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL_DAYS=7
ADMIN_EMAIL=admin@example.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-unique-admin-password-of-at-least-12-characters
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@omnisentinel.local
NOTIFICATION_EMAIL_RECIPIENTS=
NOTIFICATION_WEBHOOK_TIMEOUT_MS=5000
INCIDENT_CORRELATION_WINDOW_SECONDS=60
INCIDENT_STABILIZATION_MINUTES=5
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_LIMIT=100
SWAGGER_ENABLED=true
METRICS_ENABLED=true
METRICS_BEARER_TOKEN=
TRUST_PROXY=false
RABBITMQ_ALERT_QUEUE=api_incident_report.alerts
RABBITMQ_ALERT_RETRY_QUEUE=api_incident_report.alerts.retry
RABBITMQ_MAX_RETRIES=3
RABBITMQ_RETRY_DELAY_MS=5000
ALERT_DEDUPLICATION_TTL_SECONDS=86400
